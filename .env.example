# ─────────────────────────────────────────────────────────────────────────────
# SecOps Portal — n8n Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── n8n UI Auth ───────────────────────────────────────────────────────────────
# Username and password for the n8n web interface
N8N_USER=admin
N8N_PASSWORD=change_me_immediately

# ── Port (optional) ───────────────────────────────────────────────────────────
# n8n will bind to this port on your host. Default: 5678
N8N_PORT=5678

# ── Threat Intel: VirusTotal (required) ──────────────────────────────────────
# Free tier: 4 requests/min. Sign up at https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# ── AI Threat Summary (optional) ─────────────────────────────────────────────
# Leave OPENAI_API_KEY blank to disable AI enrichment entirely.
# The workflow will still return full threat data — just without the
# plain-English summary. No errors, no crashes.
#
# Option A — OpenAI cloud (pay-per-token, ~$0.001/scan with gpt-4o-mini):
OPENAI_API_KEY=
#
# Option B — Local Ollama (free, runs on your machine):
#   1. Install Ollama: https://ollama.com
#   2. Pull a model: ollama pull llama3
#   3. Set the base URL below and leave OPENAI_API_KEY blank or set to "ollama"
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
